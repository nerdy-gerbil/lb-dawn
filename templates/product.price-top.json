ment.querySelector(selector));\n        }\n      });\n\n      observer.observe(document.body, {\n        childList: true,\n        subtree: true\n      });\n    });\n  }\n\n  // Relocate tabs fix\n  function checkRelocated() {\n    const tableRelocated = document.querySelector('.station-tabs .product-details-table');\n    const reviewsRelocated = document.querySelector('.station-tabs #klaviyo-reviews');\n    if (tableRelocated || reviewsRelocated) {\n      document.body.setAttribute('data-tabs-relocate', 'true');\n      return true;\n    }\n    return false;\n  }\n  if (!checkRelocated()) {\n    const tabsObserver = new MutationObserver((mutations, obs) => {\n      if (checkRelocated()) {\n        obs.disconnect();\n      }\n    });\n    tabsObserver.observe(document.body, {\n      childList: true,\n      subtree: true\n    });\n    setTimeout(() => {\n      tabsObserver.disconnect();\n      document.body.setAttribute('data-tabs-relocate', 'true');\n    }, 5000);\n  }\n</script>"
