{{ 'component-accordion.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .product-faqs__heading {
    margin-bottom: 2rem;
  }

  .product-faqs__accordion {
    border-bottom: 1px solid var(--color-foreground-10, rgba(0,0,0,0.08));
    margin-bottom: 0;
  }

  .product-faqs__accordion summary {
    padding: 1.25rem 0;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 500;
    font-size: 1.6rem;
  }

  .product-faqs__content {
    padding-bottom: 1.25rem;
    font-size: 1.5rem;
    line-height: 1.6;
  }
{%- endstyle -%}

{%- liquid
  assign has_faq_content = false
  for i in (1..9)
    assign q_key = "faq_question_" | append: i
    assign a_key = "faq_answer_" | append: i
    assign q = product.metafields.custom[q_key]
    assign a = product.metafields.custom[a_key]
    if q != blank and a != blank
      assign has_faq_content = true
      break
    endif
  endfor
-%}

{%- if has_faq_content -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width{% if section.settings.narrow_layout %} page-width--narrow{% endif %} section-{{ section.id }}-padding">
      {%- if section.settings.heading != blank -%}
        <h2 class="product-faqs__heading inline-richtext {{ section.settings.heading_size }}" style="text-align: {{ section.settings.heading_alignment }};">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      <div class="product-faqs__wrapper">
        {%- for i in (1..9) -%}
          {%- assign q_key = "faq_question_" | append: i -%}
          {%- assign a_key = "faq_answer_" | append: i -%}
          {%- assign q = product.metafields.custom[q_key] -%}
          {%- assign a = product.metafields.custom[a_key] -%}
          {%- if q != blank and a != blank -%}
            <div class="accordion product-faqs__accordion">
              <details id="Details-prod-faq-{{ i }}-{{ section.id }}">
                <summary id="Summary-prod-faq-{{ i }}-{{ section.id }}">
                  <div class="accordion__title inline-richtext h4">
                    {{ q }}
                  </div>
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </summary>
                <div
                  class="accordion__content rte product-faqs__content"
                  id="CollapsibleAccordion-prod-faq-{{ i }}-{{ section.id }}"
                  role="region"
                  aria-labelledby="Summary-prod-faq-{{ i }}-{{ section.id }}"
                >
                  {{ a | metafield_tag }}
                </div>
              </details>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {% comment %} JSON-LD FAQPage Schema for Product Page {% endcomment %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- assign first_item = true -%}
      {%- for i in (1..9) -%}
        {%- assign q_key = "faq_question_" | append: i -%}
        {%- assign a_key = "faq_answer_" | append: i -%}
        {%- assign q = product.metafields.custom[q_key] -%}
        {%- assign a = product.metafields.custom[a_key] -%}
        {%- if q != blank and a != blank -%}
          {%- unless first_item -%},{%- endunless -%}
          {%- assign first_item = false -%}
          {
            "@type": "Question",
            "name": {{ q | strip_html | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ a | strip_html | json }}
            }
          }
        {%- endif -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Custom FAQs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Frequently Asked Questions",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading Size"
    },
    {
      "type": "text_alignment",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "narrow_layout",
      "label": "Use narrow layout",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Custom FAQs"
    }
  ]
}
{% endschema %}
